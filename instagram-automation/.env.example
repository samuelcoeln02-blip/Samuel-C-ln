# ============================================================
#  Instagram Automation - Umgebungsvariablen
#  Kopiere diese Datei zu ".env" und trage deine Werte ein.
#  Die echte .env wird NIE committet (siehe .gitignore).
# ============================================================

# Port fuer den lokalen Server
PORT=3000

# --- Meta / Instagram Graph API ---------------------------

# Beliebig gewaehltes Passwort. Muss identisch im Meta App
# Dashboard unter "Verify Token" eingetragen werden.
VERIFY_TOKEN=mein_geheimes_verify_token

# Long-Lived Access Token deiner Instagram-verknuepften Seite.
# Berechtigungen: instagram_manage_comments, instagram_manage_messages,
# pages_manage_metadata, pages_read_engagement
PAGE_ACCESS_TOKEN=EAAG...

# App Secret aus dem Meta App Dashboard (Einstellungen -> Allgemein).
# Wird genutzt, um die Signatur eingehender Webhooks zu pruefen.
APP_SECRET=abc123...

# Die numerische ID deines Instagram Business/Creator Accounts.
IG_BUSINESS_ID=17841400000000000

# --- PDF / Lead Magnet -------------------------------------

# Oeffentlich erreichbare URL zur PDF, die per DM verschickt wird.
# Instagram laedt die Datei von dieser URL - sie muss oeffentlich sein.
PDF_URL=https://deine-domain.de/assets/downloads/kettlebell-guide.pdf
